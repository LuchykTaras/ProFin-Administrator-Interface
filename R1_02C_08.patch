diff --git a/db/r1_02c_08_google_identity_links.sql b/db/r1_02c_08_google_identity_links.sql
new file mode 100644
index 0000000..d13de7a
--- /dev/null
+++ b/db/r1_02c_08_google_identity_links.sql
@@ -0,0 +1,66 @@
+BEGIN;
+
+CREATE TABLE public.profin_google_link_challenges (
+  challenge_id text PRIMARY KEY,
+  project_id text NOT NULL REFERENCES public.projects(project_id),
+  user_id text NOT NULL REFERENCES public.users(user_id),
+  session_id text NOT NULL REFERENCES public.sessions(session_id),
+  nonce_hash text NOT NULL CHECK (length(nonce_hash) = 64),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  expires_at timestamptz NOT NULL,
+  consumed_at timestamptz,
+  CHECK (expires_at > created_at)
+);
+
+CREATE INDEX profin_google_link_challenges_rate_idx
+  ON public.profin_google_link_challenges(project_id, user_id, created_at DESC);
+
+CREATE TABLE public.profin_google_link_requests (
+  request_id text PRIMARY KEY,
+  project_id text NOT NULL REFERENCES public.projects(project_id),
+  user_id text NOT NULL REFERENCES public.users(user_id),
+  google_sub text NOT NULL CHECK (length(google_sub) BETWEEN 1 AND 255),
+  google_email text NOT NULL CHECK (length(google_email) BETWEEN 3 AND 320),
+  status text NOT NULL DEFAULT 'PENDING'
+    CHECK (status IN ('PENDING', 'APPROVED', 'REJECTED', 'EXPIRED')),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  expires_at timestamptz NOT NULL,
+  reviewed_at timestamptz,
+  reviewed_by text REFERENCES public.users(user_id),
+  review_reason text,
+  CHECK (expires_at > created_at)
+);
+
+CREATE UNIQUE INDEX profin_google_link_requests_pending_user
+  ON public.profin_google_link_requests(project_id, user_id)
+  WHERE status = 'PENDING';
+CREATE UNIQUE INDEX profin_google_link_requests_pending_sub
+  ON public.profin_google_link_requests(project_id, google_sub)
+  WHERE status = 'PENDING';
+CREATE INDEX profin_google_link_requests_review_idx
+  ON public.profin_google_link_requests(project_id, status, created_at DESC);
+
+CREATE TABLE public.profin_google_identity_links (
+  link_id text PRIMARY KEY,
+  project_id text NOT NULL REFERENCES public.projects(project_id),
+  user_id text NOT NULL REFERENCES public.users(user_id),
+  google_sub text NOT NULL CHECK (length(google_sub) BETWEEN 1 AND 255),
+  google_email text NOT NULL CHECK (length(google_email) BETWEEN 3 AND 320),
+  request_id text NOT NULL UNIQUE REFERENCES public.profin_google_link_requests(request_id),
+  linked_at timestamptz NOT NULL DEFAULT now(),
+  linked_by text NOT NULL REFERENCES public.users(user_id),
+  revoked_at timestamptz,
+  revoked_by text REFERENCES public.users(user_id),
+  revocation_reason text
+);
+
+CREATE UNIQUE INDEX profin_google_identity_links_active_user
+  ON public.profin_google_identity_links(project_id, user_id)
+  WHERE revoked_at IS NULL;
+CREATE UNIQUE INDEX profin_google_identity_links_active_sub
+  ON public.profin_google_identity_links(project_id, google_sub)
+  WHERE revoked_at IS NULL;
+CREATE INDEX profin_google_identity_links_lookup
+  ON public.profin_google_identity_links(project_id, user_id, revoked_at);
+
+COMMIT;
diff --git a/lib/server/google-link.ts b/lib/server/google-link.ts
new file mode 100644
index 0000000..dce5451
--- /dev/null
+++ b/lib/server/google-link.ts
@@ -0,0 +1,116 @@
+import "server-only";
+
+import { OAuth2Client } from "google-auth-library";
+import { AppError } from "@/lib/server/errors";
+import { createId } from "@/lib/server/crypto";
+import type { SessionContext } from "@/lib/server/session";
+
+const googleClient = new OAuth2Client();
+
+export function googleLinkConfig() {
+  const clientId = process.env.PROFIN_GOOGLE_OAUTH_CLIENT_ID;
+  const origin = process.env.PROFIN_APP_ORIGIN;
+
+  if (process.env.PROFIN_GOOGLE_LINK_ENABLED !== "true") {
+    throw new AppError({
+      status: 403,
+      code: "GOOGLE_LINK_DISABLED",
+      userMessage: "Прив’язку Google-акаунтів вимкнено."
+    });
+  }
+  if (
+    !clientId ||
+    !/^\d+-[\w-]+\.apps\.googleusercontent\.com$/.test(clientId) ||
+    !origin || !/^https:\/\/[^/]+$/.test(origin) && origin !== "http://localhost:3000"
+  ) {
+    throw new AppError({
+      status: 503,
+      code: "GOOGLE_LINK_NOT_CONFIGURED",
+      userMessage: "Прив’язку Google не налаштовано на сервері."
+    });
+  }
+  return { clientId, origin };
+}
+
+export function requireSameOrigin(request: Request, allowedOrigin: string) {
+  if (
+    request.headers.get("origin") !== allowedOrigin ||
+    new URL(request.url).origin !== allowedOrigin
+  ) {
+    throw new AppError({
+      status: 403,
+      code: "GOOGLE_LINK_ORIGIN_DENIED",
+      userMessage: "Недозволене походження запиту."
+    });
+  }
+}
+
+export async function readBody(request: Request): Promise<Record<string, unknown>> {
+  if (!(request.headers.get("content-type") || "").startsWith("application/json")) {
+    throw new AppError({ status: 415, code: "JSON_REQUIRED", userMessage: "Очікується JSON." });
+  }
+  if (Number(request.headers.get("content-length") || 0) > 16000) {
+    throw new AppError({ status: 413, code: "BODY_TOO_LARGE", userMessage: "Завеликий запит." });
+  }
+  const raw = await request.text();
+  if (raw.length > 16000) {
+    throw new AppError({ status: 413, code: "BODY_TOO_LARGE", userMessage: "Завеликий запит." });
+  }
+  let value: unknown;
+  try { value = JSON.parse(raw); }
+  catch { throw new AppError({ status: 400, code: "INVALID_JSON", userMessage: "Некоректний JSON." }); }
+  if (value === null || typeof value !== "object" || Array.isArray(value)) {
+    throw new AppError({ status: 400, code: "INVALID_JSON", userMessage: "Очікується JSON-об’єкт." });
+  }
+  return value as Record<string, unknown>;
+}
+
+export function requireString(value: unknown, max = 500): string {
+  if (typeof value !== "string" || value.length === 0 || value.length > max) {
+    throw new AppError({ status: 400, code: "INVALID_INPUT", userMessage: "Неприпустимі параметри." });
+  }
+  return value;
+}
+
+export async function verifiedGoogleIdentity(token: string, nonce: string, clientId: string) {
+  let payload;
+  try {
+    const ticket = await googleClient.verifyIdToken({ idToken: token, audience: clientId });
+    payload = ticket.getPayload();
+  } catch {
+    throw new AppError({ status: 401, code: "GOOGLE_TOKEN_INVALID", userMessage: "Google ID token недійсний." });
+  }
+  const email = payload?.email?.trim().toLowerCase();
+  if (
+    !payload || payload.nonce !== nonce ||
+    typeof payload.sub !== "string" || !payload.sub || payload.sub.length > 255 ||
+    !email || email.length > 320 || payload.email_verified !== true
+  ) {
+    throw new AppError({ status: 403, code: "GOOGLE_IDENTITY_UNVERIFIED", userMessage: "Не підтверджено Google-особу або nonce." });
+  }
+  return { sub: payload.sub, email };
+}
+
+export function requireOwner(context: SessionContext) {
+  if (context.role !== "OWNER") {
+    throw new AppError({ status: 403, code: "OWNER_REQUIRED", userMessage: "Потрібні повноваження власника." });
+  }
+}
+
+export function disabledFinancialAccess() {
+  return {
+    googleLoginEnabled: false,
+    appsScriptAclVerified: false,
+    shiftSnapshotAuthorized: false,
+    canSubmit: false
+  } as const;
+}
+
+export const createLinkId = () => createId("glink");
+export const createLinkRequestId = () => createId("glreq");
+export const createLinkChallengeId = () => createId("glchal");
+
+export function noStore<T extends Response>(response: T): T {
+  response.headers.set("Cache-Control", "private, no-store");
+  return response;
+}
diff --git a/app/api/auth/google-links/route.ts b/app/api/auth/google-links/route.ts
new file mode 100644
index 0000000..122935f
--- /dev/null
+++ b/app/api/auth/google-links/route.ts
@@ -0,0 +1,200 @@
+import { randomBytes } from "node:crypto";
+import {
+  apiFromError, apiOk, getRequestId
+} from "@/lib/server/api";
+import { createId, sha256 } from "@/lib/server/crypto";
+import { db } from "@/lib/server/db";
+import { AppError } from "@/lib/server/errors";
+import {
+  googleLinkConfig, requireSameOrigin, readBody, requireString,
+  verifiedGoogleIdentity, disabledFinancialAccess,
+  createLinkChallengeId, createLinkRequestId, noStore
+} from "@/lib/server/google-link";
+import { verifyPassword } from "@/lib/server/password";
+import { assertPermission } from "@/lib/server/rbac";
+import { requireSessionContext } from "@/lib/server/session";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(request: Request) {
+  const requestId = getRequestId(request);
+  try {
+    googleLinkConfig();
+    const context = await requireSessionContext();
+    assertPermission(context, "shift:read");
+    const sql = db();
+    const [links, pending] = await Promise.all([
+      sql`
+        SELECT link_id AS "linkId", google_email AS "googleEmail", linked_at AS "linkedAt"
+        FROM public.profin_google_identity_links
+        WHERE project_id = ${context.projectId}
+          AND user_id = ${context.userId} AND revoked_at IS NULL
+        ORDER BY linked_at DESC LIMIT 1
+      `,
+      sql`
+        SELECT request_id AS "requestId", status, expires_at AS "expiresAt"
+        FROM public.profin_google_link_requests
+        WHERE project_id = ${context.projectId}
+          AND user_id = ${context.userId}
+          AND status = 'PENDING' AND expires_at > NOW()
+        ORDER BY created_at DESC LIMIT 1
+      `
+    ]);
+    return noStore(apiOk(requestId, {
+      link: links[0] ?? null,
+      pendingRequest: pending[0] ?? null,
+      ...disabledFinancialAccess()
+    }, "Статус Google-прив’язки отримано.", "GOOGLE_LINK_STATUS_OK"));
+  } catch (error) {
+    return noStore(apiFromError(requestId, error));
+  }
+}
+
+export async function POST(request: Request) {
+  const requestId = getRequestId(request);
+  try {
+    const { clientId, origin } = googleLinkConfig();
+    const context = await requireSessionContext();
+    assertPermission(context, "shift:read");
+    requireSameOrigin(request, origin);
+    const body = await readBody(request);
+    const action = requireString(body.action, 20);
+    const sql = db();
+
+    if (action === "challenge") {
+      const nonce = randomBytes(32).toString("base64url");
+      const challengeId = createLinkChallengeId();
+      const expiresAt = new Date(Date.now() + 5 * 60 * 1000);
+      await sql.begin(async tx => {
+        const users = await tx`
+          SELECT user_id FROM public.users
+          WHERE user_id = ${context.userId} AND project_id = ${context.projectId}
+            AND role = ${context.role} AND status = 'ACTIVE'
+            AND revoked_at IS NULL AND password_reset_required = FALSE
+          FOR UPDATE
+        `;
+        if (users.length !== 1) {
+          throw new AppError({ status: 403, code: "USER_NOT_ELIGIBLE", userMessage: "Обліковий запис не готовий до прив’язки." });
+        }
+        const attempts = await tx`
+          SELECT count(*)::int AS total FROM public.profin_google_link_challenges
+          WHERE project_id = ${context.projectId} AND user_id = ${context.userId}
+            AND created_at > NOW() - INTERVAL '15 minutes'
+        `;
+        if (Number(attempts[0]?.total || 0) >= 5) {
+          throw new AppError({ status: 429, code: "LINK_RATE_LIMIT", userMessage: "Забагато спроб. Повторіть пізніше." });
+        }
+        await tx`
+          INSERT INTO public.profin_google_link_challenges
+            (challenge_id, project_id, user_id, session_id, nonce_hash, expires_at)
+          VALUES (${challengeId}, ${context.projectId}, ${context.userId},
+            ${context.sessionId}, ${sha256(nonce)}, ${expiresAt})
+        `;
+      });
+      return noStore(apiOk(requestId, {
+        clientId, challengeId, nonce,
+        expiresInSeconds: 300,
+        ...disabledFinancialAccess()
+      }, "Google-перевірку підготовлено.", "GOOGLE_LINK_CHALLENGE_OK"));
+    }
+
+    if (action !== "request") {
+      throw new AppError({ status: 400, code: "INVALID_ACTION", userMessage: "Невідома дія." });
+    }
+
+    const challengeId = requireString(body.challengeId, 100);
+    const nonce = requireString(body.nonce, 100);
+    const credential = requireString(body.credential, 12000);
+    const password = requireString(body.password, 256);
+    if (!/^[A-Za-z0-9_-]{43}$/.test(nonce) || credential.length < 100) {
+      throw new AppError({ status: 400, code: "INVALID_GOOGLE_PROOF", userMessage: "Неправильний формат підтвердження." });
+    }
+
+    const consumed = await sql`
+      UPDATE public.profin_google_link_challenges
+      SET consumed_at = NOW()
+      WHERE challenge_id = ${challengeId}
+        AND nonce_hash = ${sha256(nonce)}
+        AND project_id = ${context.projectId}
+        AND user_id = ${context.userId}
+        AND session_id = ${context.sessionId}
+        AND consumed_at IS NULL AND expires_at > NOW()
+      RETURNING challenge_id
+    `;
+    if (consumed.length !== 1) {
+      throw new AppError({ status: 409, code: "LINK_CHALLENGE_USED", userMessage: "Перевірка використана або прострочена." });
+    }
+
+    const google = await verifiedGoogleIdentity(credential, nonce, clientId);
+    const userRows = await sql`
+      SELECT password_hash AS "passwordHash", password_reset_required AS "resetRequired"
+      FROM public.users WHERE user_id = ${context.userId}
+        AND project_id = ${context.projectId} AND role = ${context.role}
+        AND status = 'ACTIVE' AND revoked_at IS NULL
+    `;
+    const user = userRows[0] as { passwordHash: string | null; resetRequired: boolean } | undefined;
+    if (!user?.passwordHash || user.resetRequired || !await verifyPassword(password, user.passwordHash)) {
+      throw new AppError({ status: 403, code: "PROFIN_REAUTH_FAILED", userMessage: "Не підтверджено пароль ProFin." });
+    }
+
+    const linkRequestId = createLinkRequestId();
+    try {
+      await sql.begin(async tx => {
+        const locked = await tx`
+          SELECT user_id FROM public.users
+          WHERE user_id = ${context.userId} AND project_id = ${context.projectId}
+            AND role = ${context.role} AND status = 'ACTIVE'
+            AND revoked_at IS NULL AND password_reset_required = FALSE
+          FOR UPDATE
+        `;
+        if (locked.length !== 1) {
+          throw new AppError({ status: 403, code: "USER_NOT_ELIGIBLE", userMessage: "Користувач недоступний." });
+        }
+        await tx`
+          UPDATE public.profin_google_link_requests SET status = 'EXPIRED'
+          WHERE project_id = ${context.projectId} AND status = 'PENDING'
+            AND expires_at <= NOW()
+            AND (user_id = ${context.userId} OR google_sub = ${google.sub})
+        `;
+        const active = await tx`
+          SELECT link_id FROM public.profin_google_identity_links
+          WHERE project_id = ${context.projectId} AND revoked_at IS NULL
+            AND (user_id = ${context.userId} OR google_sub = ${google.sub})
+          LIMIT 1
+        `;
+        if (active.length) {
+          throw new AppError({ status: 409, code: "GOOGLE_LINK_EXISTS", userMessage: "Обліковий запис уже має прив’язку." });
+        }
+        await tx`
+          INSERT INTO public.profin_google_link_requests
+            (request_id, project_id, user_id, google_sub, google_email, expires_at)
+          VALUES (${linkRequestId}, ${context.projectId}, ${context.userId},
+            ${google.sub}, ${google.email}, NOW() + INTERVAL '24 hours')
+        `;
+        await tx`
+          INSERT INTO public.audit_events
+            (event_id, request_id, actor_user_id, actor_role, project_id, location_id,
+              financial_year, action, target_type, target_id, after_snapshot, result)
+          VALUES (${createId("evt")}, ${requestId}, ${context.userId}, ${context.role},
+            ${context.projectId}, ${context.locationId}, ${context.activeYear},
+            'GOOGLE_LINK_REQUESTED', 'GOOGLE_IDENTITY_LINK', ${linkRequestId},
+            ${JSON.stringify({ status: "PENDING", userId: context.userId })}::jsonb, 'COMPLETED')
+        `;
+      });
+    } catch (error) {
+      if ((error as { code?: string })?.code === "23505") {
+        throw new AppError({ status: 409, code: "GOOGLE_LINK_REQUEST_CONFLICT", userMessage: "Прив’язку вже запитано для цього користувача або Google-акаунту." });
+      }
+      throw error;
+    }
+
+    return noStore(apiOk(requestId, {
+      requestId: linkRequestId,
+      status: "PENDING_OWNER_APPROVAL",
+      ...disabledFinancialAccess()
+    }, "Запит на прив’язку створено. Очікується підтвердження власника.", "GOOGLE_LINK_REQUESTED"));
+  } catch (error) {
+    return noStore(apiFromError(requestId, error));
+  }
+}
diff --git a/app/api/admin/google-links/route.ts b/app/api/admin/google-links/route.ts
new file mode 100644
index 0000000..ce253eb
--- /dev/null
+++ b/app/api/admin/google-links/route.ts
@@ -0,0 +1,248 @@
+import {
+  apiFromError, apiOk, getRequestId
+} from "@/lib/server/api";
+import { createId } from "@/lib/server/crypto";
+import { db } from "@/lib/server/db";
+import { AppError } from "@/lib/server/errors";
+import {
+  createLinkId, disabledFinancialAccess, googleLinkConfig,
+  noStore, readBody, requireOwner, requireSameOrigin, requireString
+} from "@/lib/server/google-link";
+import { verifyPassword } from "@/lib/server/password";
+import { assertPermission } from "@/lib/server/rbac";
+import { requireSessionContext } from "@/lib/server/session";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+export async function GET(request: Request) {
+  const requestId = getRequestId(request);
+  try {
+    googleLinkConfig();
+    const context = await requireSessionContext();
+    requireOwner(context);
+    assertPermission(context, "users:manage");
+    const sql = db();
+    const [requests, links] = await Promise.all([
+      sql`
+        SELECT r.request_id AS "requestId", r.user_id AS "userId",
+          u.display_name AS "userName", u.role AS "role",
+          r.google_email AS "googleEmail", r.expires_at AS "expiresAt"
+        FROM public.profin_google_link_requests r
+        JOIN public.users u ON u.user_id = r.user_id AND u.project_id = r.project_id
+        WHERE r.project_id = ${context.projectId} AND r.status = 'PENDING'
+          AND r.expires_at > NOW() AND u.status = 'ACTIVE' AND u.revoked_at IS NULL
+        ORDER BY r.created_at DESC LIMIT 100
+      `,
+      sql`
+        SELECT l.link_id AS "linkId", l.user_id AS "userId",
+          u.display_name AS "userName", u.role AS "role",
+          l.google_email AS "googleEmail", l.linked_at AS "linkedAt"
+        FROM public.profin_google_identity_links l
+        JOIN public.users u ON u.user_id = l.user_id AND u.project_id = l.project_id
+        WHERE l.project_id = ${context.projectId} AND l.revoked_at IS NULL
+        ORDER BY l.linked_at DESC LIMIT 100
+      `
+    ]);
+    return noStore(apiOk(requestId, {
+      pendingRequests: requests, activeLinks: links,
+      ...disabledFinancialAccess()
+    }, "Прив’язки Google отримано.", "GOOGLE_LINK_OWNER_LIST_OK"));
+  } catch (error) {
+    return noStore(apiFromError(requestId, error));
+  }
+}
+
+export async function POST(request: Request) {
+  const requestId = getRequestId(request);
+  try {
+    const { origin } = googleLinkConfig();
+    const context = await requireSessionContext();
+    requireOwner(context);
+    assertPermission(context, "users:manage");
+    requireSameOrigin(request, origin);
+    const body = await readBody(request);
+    const action = requireString(body.action, 20);
+    if (!(["approve", "reject", "revoke"] as string[]).includes(action)) {
+      throw new AppError({ status: 400, code: "INVALID_LINK_ACTION", userMessage: "Невідома дія." });
+    }
+    const targetId = requireString(body.id, 120);
+    const password = requireString(body.password, 256);
+    const reason = action === "approve"
+      ? "Підтверджено власником після перевірки Google-особи"
+      : requireString(body.reason, 500).trim();
+    if (reason.length < 10) {
+      throw new AppError({ status: 400, code: "REASON_REQUIRED", userMessage: "Потрібна причина (не менше 10 символів)." });
+    }
+
+    const sql = db();
+    // Every attempt is audited before password verification; cap attempts per owner.
+    await sql.begin(async tx => {
+      const owner = await tx`
+        SELECT user_id FROM public.users
+        WHERE user_id = ${context.userId} AND project_id = ${context.projectId}
+          AND role = 'OWNER' AND status = 'ACTIVE' AND revoked_at IS NULL
+        FOR UPDATE
+      `;
+      if (owner.length !== 1) {
+        throw new AppError({ status: 403, code: "OWNER_REQUIRED", userMessage: "Права власника не підтверджено." });
+      }
+      const attempts = await tx`
+        SELECT COUNT(*)::int AS total FROM public.audit_events
+        WHERE actor_user_id = ${context.userId} AND project_id = ${context.projectId}
+          AND action = 'GOOGLE_LINK_OWNER_ATTEMPT'
+          AND occurred_at > NOW() - INTERVAL '15 minutes'
+      `;
+      if (Number(attempts[0]?.total || 0) >= 5) {
+        throw new AppError({ status: 429, code: "OWNER_LINK_RATE_LIMIT", userMessage: "Ліміт підтверджень перевищено. Спробуйте пізніше." });
+      }
+      await tx`
+        INSERT INTO public.audit_events
+          (event_id, request_id, actor_user_id, actor_role, project_id, location_id,
+            financial_year, action, target_type, target_id, result)
+        VALUES (${createId("evt")}, ${requestId}, ${context.userId}, ${context.role},
+          ${context.projectId}, ${context.locationId}, ${context.activeYear},
+          'GOOGLE_LINK_OWNER_ATTEMPT', 'GOOGLE_IDENTITY_LINK', ${targetId}, 'RECEIVED')
+      `;
+    });
+
+    const owners = await sql`
+      SELECT password_hash AS "passwordHash", password_reset_required AS "resetRequired"
+      FROM public.users WHERE user_id = ${context.userId}
+        AND project_id = ${context.projectId}
+        AND role = 'OWNER' AND status = 'ACTIVE' AND revoked_at IS NULL
+    `;
+    const owner = owners[0] as { passwordHash: string | null; resetRequired: boolean } | undefined;
+    if (!owner?.passwordHash || owner.resetRequired || !await verifyPassword(password, owner.passwordHash)) {
+      throw new AppError({ status: 403, code: "OWNER_REAUTH_FAILED", userMessage: "Не підтверджено пароль власника." });
+    }
+
+    if (action === "revoke") {
+      const changed = await sql.begin(async tx => {
+        const rows = await tx`
+          SELECT link_id AS "linkId", user_id AS "userId"
+          FROM public.profin_google_identity_links
+          WHERE link_id = ${targetId} AND project_id = ${context.projectId}
+            AND revoked_at IS NULL
+          FOR UPDATE
+        `;
+        const link = rows[0] as { linkId: string; userId: string } | undefined;
+        if (!link) {
+          throw new AppError({ status: 404, code: "LINK_NOT_FOUND", userMessage: "Активну прив’язку не знайдено." });
+        }
+        await tx`
+          UPDATE public.profin_google_identity_links
+          SET revoked_at = NOW(), revoked_by = ${context.userId}, revocation_reason = ${reason}
+          WHERE link_id = ${targetId} AND revoked_at IS NULL
+        `;
+        // Revoked identity must not leave an active session behind.
+        await tx`
+          UPDATE public.users SET token_version = token_version + 1
+          WHERE user_id = ${link.userId} AND project_id = ${context.projectId}
+        `;
+        await tx`
+          UPDATE public.sessions SET revoked_at = NOW()
+          WHERE user_id = ${link.userId} AND project_id = ${context.projectId}
+            AND revoked_at IS NULL
+        `;
+        await tx`
+          INSERT INTO public.audit_events
+            (event_id, request_id, actor_user_id, actor_role, project_id, location_id,
+              financial_year, action, target_type, target_id, reason, result)
+          VALUES (${createId("evt")}, ${requestId}, ${context.userId}, ${context.role},
+            ${context.projectId}, ${context.locationId}, ${context.activeYear},
+            'GOOGLE_LINK_REVOKED', 'GOOGLE_IDENTITY_LINK', ${targetId}, ${reason}, 'COMPLETED')
+        `;
+        return link;
+      });
+      return noStore(apiOk(requestId, {
+        linkId: changed.linkId, status: "REVOKED",
+        sessionsRevoked: true, ...disabledFinancialAccess()
+      }, "Прив’язку відкликано, сесії завершено.", "GOOGLE_LINK_REVOKED"));
+    }
+
+    let result: { status: string; userId: string };
+    try {
+      result = await sql.begin(async tx => {
+        const rows = await tx`
+          SELECT request_id AS "requestId", user_id AS "userId",
+            google_sub AS "googleSub", google_email AS "googleEmail"
+          FROM public.profin_google_link_requests
+          WHERE request_id = ${targetId} AND project_id = ${context.projectId}
+            AND status = 'PENDING' AND expires_at > NOW()
+          FOR UPDATE
+        `;
+        const pending = rows[0] as {
+          requestId: string; userId: string; googleSub: string; googleEmail: string
+        } | undefined;
+        if (!pending) {
+          throw new AppError({ status: 409, code: "LINK_REQUEST_NOT_ACTIVE", userMessage: "Заявка вже оброблена або прострочена." });
+        }
+        const users = await tx`
+          SELECT role FROM public.users WHERE user_id = ${pending.userId}
+            AND project_id = ${context.projectId} AND status = 'ACTIVE'
+            AND revoked_at IS NULL AND password_reset_required = FALSE
+          FOR UPDATE
+        `;
+        if (users.length !== 1) {
+          throw new AppError({ status: 403, code: "LINK_USER_INACTIVE", userMessage: "Користувач недоступний." });
+        }
+        if (
+          pending.userId === context.userId &&
+          (process.env.PROFIN_GOOGLE_OWNER_SELF_LINK_ENABLED !== "true" || users[0].role !== "OWNER")
+        ) {
+          throw new AppError({ status: 403, code: "OWNER_SELF_LINK_DISABLED", userMessage: "Самостійне підтвердження власника вимкнено." });
+        }
+        if (action === "approve") {
+          const active = await tx`
+            SELECT link_id FROM public.profin_google_identity_links
+            WHERE project_id = ${context.projectId} AND revoked_at IS NULL
+              AND (user_id = ${pending.userId} OR google_sub = ${pending.googleSub})
+            LIMIT 1
+          `;
+          if (active.length) {
+            throw new AppError({ status: 409, code: "GOOGLE_LINK_EXISTS", userMessage: "Виявлено іншу активну прив’язку." });
+          }
+          const linkId = createLinkId();
+          await tx`
+            INSERT INTO public.profin_google_identity_links
+              (link_id, project_id, user_id, google_sub, google_email,
+                request_id, linked_by)
+            VALUES (${linkId}, ${context.projectId}, ${pending.userId},
+              ${pending.googleSub}, ${pending.googleEmail}, ${pending.requestId}, ${context.userId})
+          `;
+        }
+        const status = action === "approve" ? "APPROVED" : "REJECTED";
+        await tx`
+          UPDATE public.profin_google_link_requests
+          SET status = ${status}, reviewed_at = NOW(),
+            reviewed_by = ${context.userId}, review_reason = ${reason}
+          WHERE request_id = ${targetId} AND status = 'PENDING'
+        `;
+        await tx`
+          INSERT INTO public.audit_events
+            (event_id, request_id, actor_user_id, actor_role, project_id, location_id,
+              financial_year, action, target_type, target_id, reason, after_snapshot, result)
+          VALUES (${createId("evt")}, ${requestId}, ${context.userId}, ${context.role},
+            ${context.projectId}, ${context.locationId}, ${context.activeYear},
+            ${action === "approve" ? "GOOGLE_LINK_APPROVED" : "GOOGLE_LINK_REJECTED"},
+            'GOOGLE_IDENTITY_LINK', ${targetId}, ${reason},
+            ${JSON.stringify({ status, userId: pending.userId })}::jsonb, 'COMPLETED')
+        `;
+        return { status, userId: pending.userId };
+      });
+    } catch (error) {
+      if ((error as { code?: string })?.code === "23505") {
+        throw new AppError({ status: 409, code: "GOOGLE_LINK_CONFLICT", userMessage: "Прив’язка вже існує." });
+      }
+      throw error;
+    }
+    return noStore(apiOk(requestId, {
+      status: result.status,
+      ...disabledFinancialAccess()
+    }, result.status === "APPROVED" ? "Прив’язку підтверджено." : "Заявку відхилено.",
+    result.status === "APPROVED" ? "GOOGLE_LINK_APPROVED" : "GOOGLE_LINK_REJECTED"));
+  } catch (error) {
+    return noStore(apiFromError(requestId, error));
+  }
+}
